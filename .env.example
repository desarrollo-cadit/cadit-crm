# ============================================================
# CadIT CRM — variables de entorno
# Copia este archivo a `.env` y reemplaza cada REEMPLAZA_...
# En producción estas variables van en tu plataforma de hosting
# (Coolify / docker compose), no solo en el archivo.
# ============================================================

# --- Aplicación ---------------------------------------------
# URL pública de la instancia (con https en producción).
# De ella se construye la URL del webhook de WhatsApp.
APP_BASE_URL=REEMPLAZA_https://crm.tudominio.com

# Solo Ruta B (docker compose): dominio para el HTTPS automático de Caddy.
DOMAIN=REEMPLAZA_crm.tudominio.com

# --- Base de datos ------------------------------------------
# Ruta B usa el servicio interno `postgres` del compose.
# Genera la contraseña con:  openssl rand -hex 24
POSTGRES_PASSWORD=REEMPLAZA_password_de_postgres
DATABASE_URL=postgresql://postgres:REEMPLAZA_password_de_postgres@postgres:5432/vocero

# Conexión con la que se aplican las migraciones al arrancar el contenedor
# (Dockerfile). Si la app corre como `cadit_app` (sujeto a RLS), esta debe ser
# la del DUEÑO de las tablas (postgres). Vacía = usa DATABASE_URL.
# Ver docs/rls-rol-de-conexion.md.
# MIGRATION_DATABASE_URL=postgresql://postgres:REEMPLAZA@postgres:5432/vocero

# --- Secretos de la aplicación ------------------------------
# Firma de sesiones. Genera con:  openssl rand -base64 32
BETTER_AUTH_SECRET=REEMPLAZA_secreto_de_sesiones

# Cifrado en reposo del token de WhatsApp (AES-256-GCM).
# DEBE ser exactamente 32 bytes en base64 (44 caracteres).
# Genera con:  openssl rand -base64 32
ENCRYPTION_KEY=REEMPLAZA_clave_de_cifrado_base64

# --- WhatsApp (webhook) -------------------------------------
# Token de verificación del webhook. Es también el segmento secreto
# de la URL del webhook: /api/webhooks/wa/<este_valor>
# Genera con:  openssl rand -hex 32
META_WEBHOOK_VERIFY_TOKEN=REEMPLAZA_token_de_verificacion

# OPCIONAL (recomendado en modo directo): App Secret de tu app de Meta
# para validar la firma de cada webhook (x-hub-signature-256).
# Se obtiene en developers.facebook.com → tu app → Configuración → Básica.
# En modo agencia normalmente se deja vacío (la URL secreta protege el webhook).
# META_APP_SECRET=

# Versión de la Graph API (déjala así salvo que sepas por qué cambiarla).
META_GRAPH_API_VERSION=v25.0

# --- Inteligencia artificial (opcional) ---------------------
# Sin token, el CRM funciona completo excepto Agente y Laboratorio.
# Crea tu key en https://openrouter.ai → Keys (o usa cualquier proveedor
# compatible con la API de OpenRouter cambiando OPENROUTER_BASE_URL).
# OPENROUTER_API_TOKEN=
# OPENROUTER_BASE_URL=https://openrouter.ai/api
# Modelo principal del agente (ej.: anthropic/claude-sonnet-4.5)
# OPENROUTER_MODEL=
# Modelo del juez del Laboratorio (si se omite, usa el principal)
# OPENROUTER_JUDGE_MODEL=

# --- Operación (opcional) -----------------------------------
# Reabrir el registro público después de la primera organización.
# ALLOW_SIGNUP=true

# Milisegundos de agrupación de mensajes antes del turno del agente (default 6000).
# AGENT_COALESCE_MS=6000

# --- Cerebro externo (opcional) -----------------------------
# Si en vez del agente in-process prefieres tu propio bot (un microservicio en
# el mismo servidor), habilita la API de servicio /api/bot/* con una API key:
# el bot marca leído + "escribiendo…", descarga adjuntos y reinicia la
# conversación de pruebas SIN que el token de WhatsApp salga del CRM.
# Genera una larga y aleatoria (mínimo 16 caracteres); sin ella, /api/bot/*
# responde 401 y el CRM funciona igual con su agente propio.
#   openssl rand -base64 32
# BOT_API_KEY=

# 008 - Directorio del volumen local de adjuntos (imagenes, docs, audios).
# En Coolify: montar un persistent storage en /data/media y poner esa ruta aqui.
# En dev local puede quedar el default relativo.
MEDIA_DIR=./.dev-media

# 029 — Bases de Entra ID y de Microsoft Graph para el correo (opcionales).
# Dejar VACÍAS en producción: se usan https://login.microsoftonline.com y
# https://graph.microsoft.com/v1.0. En local apuntar al m365-mock (requiere
# WA_MOCK_ENABLED=true), que guarda los correos en /api/dev/m365-mock/outbox:
#   M365_GRAPH_BASE_URL=http://localhost:3000/api/dev/m365-mock/v1.0
#   M365_LOGIN_BASE_URL=http://localhost:3000/api/dev/m365-mock
M365_GRAPH_BASE_URL=
M365_LOGIN_BASE_URL=

# --- Correo transaccional: Microsoft 365 / Graph (opcional) --
# Sin estas cuatro la app arranca igual y las acciones de correo responden
# "no configurado". Registro de app en Entra ID (portal.azure.com → App
# registrations) con el permiso de aplicación Mail.Send y consentimiento de
# administrador. Acotá el buzón con una ApplicationAccessPolicy en Exchange
# Online (ver src/lib/m365/client.ts).
# M365_TENANT_ID=REEMPLAZA_id_del_tenant
# M365_CLIENT_ID=REEMPLAZA_id_de_la_app
# M365_CLIENT_SECRET=REEMPLAZA_secreto_de_la_app
# Buzón remitente (ej.: academia@tudominio.com).
# M365_SENDER=REEMPLAZA_buzon_remitente
# Opcional: copia oculta de cada correo enviado, para registro del equipo.
# M365_BCC=

# Pausa entre correos de un envío masivo por grupo (ms). Exchange limita
# ~30 mensajes/min por buzón: 2000 deja margen. 0 solo en pruebas.
# BULK_SEND_PAUSE_MS=2000

# --- Campañas de marketing (045, opcional) ------------------
# Pausa entre correos de una campaña (ms; 2000 ≈ 30/min). 0 solo en pruebas.
# MARKETING_SEND_PAUSE_MS=2000
# Segundos entre pasadas que retoman campañas pendientes; 0 = solo al arrancar.
# MARKETING_TICK_SEC=60
# (El buzón de marketing, el remitente y el pie se configuran desde
# /settings/marketing, no acá.)

# --- Tareas periódicas (todas apagadas por defecto) ---------
# Minutos entre pasadas; 0 = apagada. Se encienden A PROPÓSITO, una vez
# configurado lo que necesitan. Nunca corren en tests ni en `next build`.
#
# 039 — Avisos internos por correo (facturación T-7/T-2, Soporte, cobranza,
# nuevos interesados). Requiere M365 y las áreas configuradas. Ej.: 60.
STAFF_NOTICES_INTERVAL_MIN=0
# 0084 — Recordatorio por correo a alumnos que no entregaron (minutos entre pasadas; 0 = apagado). Encender (p. ej. 60) con M365 configurado.
ASSESSMENT_REMINDER_INTERVAL_MIN=0
# 0084 — Días antes del plazo vigente en que se recuerda (1..30).
ASSESSMENT_REMINDER_DAYS=2
# 033 — Recordatorio de talleres por WhatsApp (el día anterior). Requiere
# plantillas aprobadas. Ej.: 15.
WORKSHOP_REMINDER_INTERVAL_MIN=0
# 033 — Confirmación por WhatsApp al anotarse a un taller: solo con `true`.
# WORKSHOP_CONFIRMATION_ENABLED=

# --- Zoom (030, opcional) -----------------------------------
# Las CREDENCIALES de Zoom NO van acá: se cargan cifradas desde
# Configuración › Zoom (Server-to-Server OAuth, una conexión por cuenta).
# Bases de la API: VACÍAS en producción (https://api.zoom.us/v2 y
# https://zoom.us). En local, al zoom-mock (requiere WA_MOCK_ENABLED=true):
#   ZOOM_API_BASE_URL=http://localhost:3000/api/dev/zoom-mock/v2
#   ZOOM_OAUTH_BASE_URL=http://localhost:3000/api/dev/zoom-mock
ZOOM_API_BASE_URL=
ZOOM_OAUTH_BASE_URL=
# Sincronización periódica de grabaciones (minutos; 0 = solo el botón).
# Encender (ej. 60) recién después de probar la cuenta real con el botón.
ZOOM_SYNC_INTERVAL_MIN=0
# Días hacia atrás de la primera corrida de una conexión.
# ZOOM_SYNC_BACKFILL_DAYS=90
# Días que cada corrida vuelve a mirar (grabaciones que Zoom publica tarde).
# ZOOM_SYNC_OVERLAP_DAYS=3
# Días que re-lista la verificación diaria de borradas (7..180).
# ZOOM_VERIFY_DAYS=180
# Días que una grabación faltante se conserva antes de borrarla del CRM.
# ZOOM_MISSING_PURGE_DAYS=30
# Grabaciones más cortas que esto (minutos) no se guardan; 0 apaga el filtro.
# ZOOM_MIN_RECORDING_MIN=15
# Adjudicación: minutos de tolerancia antes del inicio de la clase.
# ZOOM_MATCH_BEFORE_MIN=30
# Fin supuesto de una clase sin hora de fin (minutos desde el inicio).
# ZOOM_MATCH_AFTER_FALLBACK_MIN=180
#
# Asistencia sugerida desde Zoom (constitución 1.9.0). Requiere los permisos
# de reportes en la app de Zoom. Minutos entre pasadas; 0 = solo el botón.
ZOOM_ATTENDANCE_INTERVAL_MIN=0
# Minutos después del fin de la clase antes del primer intento.
# ZOOM_ATTENDANCE_DELAY_MIN=30
# Días que se guardan los tramos crudos de participantes (1..365).
# ZOOM_ATTENDANCE_RAW_DAYS=180
# Clases por pasada (1..200) y pausa entre clases (ms; 0 solo en pruebas).
# ZOOM_ATTENDANCE_BATCH=20
# ZOOM_ATTENDANCE_PAUSE_MS=1000

# --- Formularios y catálogo públicos (007, opcional) --------
# Orígenes que pueden llamar /api/public/* desde el navegador, separados por
# coma (ej.: https://cadit.com.uy,https://www.cadit.com.uy). `*` = cualquiera.
# PUBLIC_CORS_ORIGINS=*
# Envíos del formulario público permitidos por IP y por ventana (ms).
# PUBLIC_FORM_RATE_LIMIT=5
# PUBLIC_FORM_RATE_WINDOW_MS=600000

# --- Entorno de pruebas interno (SOLO desarrollo) -----------
# Enciende los mocks de /api/dev/* (WhatsApp, IA, M365, Zoom). En producción
# responden 404 igual, pero NUNCA lo actives ahí.
# WA_MOCK_ENABLED=true
# Base de la Graph API de Meta. En local, al wa-mock:
#   META_GRAPH_BASE_URL=http://localhost:3000/api/dev/wa-mock
# META_GRAPH_BASE_URL=https://graph.facebook.com
# Puerto del dev server (lo usa el wa-mock para enviarse los entrantes).
# PORT=3000

# --- Build, migraciones y scripts (opcional) ----------------
# Directorio de salida de `next build`. Con `pnpm dev` corriendo, usá OTRO
# (ej.: .next-build) o se pisan los chunks del dev server.
# NEXT_DIST_DIR=.next-build
# Carpeta de migraciones que aplica scripts/migrate.mjs al arrancar el
# contenedor (default: ./drizzle junto al script).
# MIGRATIONS_DIR=
# scripts/verify-rls.mjs — conexiones para verificar RLS: una como dueño de
# las tablas (postgres) y otra como cadit_app (ver docs/rls-rol-de-conexion.md).
# RLS_OWNER_URL=postgresql://postgres:REEMPLAZA@localhost:5432/vocero
# RLS_APP_URL=postgresql://cadit_app:REEMPLAZA@localhost:5432/vocero
# scripts/e2e-selftest.mjs — secciones a correr (separadas por coma; vacío =
# todas) y carpeta donde guardar capturas de pantalla.
# E2E_SECCIONES=
# E2E_CAPTURAS=
# scripts/demos — ruta a ffmpeg si no está en el PATH.
# FFMPEG_PATH=
# scripts/import/cadit-2026.ts — carpeta de los CSV a importar
# (default: ~/Downloads).
# CADIT_CSV_DIR=