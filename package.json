{
  "name": "vocero-crm",
  "version": "1.0.0",
  "description": "CRM de WhatsApp open source y self-hosted con agente de IA y Laboratorio de auto-evaluación",
  "license": "MIT",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node --env-file=.env scripts/e2e-selftest.mjs",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed:demo": "esbuild scripts/seed/demo.ts --bundle --platform=node --format=esm --outfile=.tmp-seed-demo.mjs --alias:@=./src --packages=external && node .tmp-seed-demo.mjs",
    "seed:academic": "esbuild scripts/seed/academic.ts --bundle --platform=node --format=esm --outfile=.tmp-seed-academic.mjs --alias:@=./src --packages=external && node .tmp-seed-academic.mjs",
    "reset-password": "esbuild scripts/reset-password.ts --bundle --platform=node --format=esm --outfile=.tmp-reset-password.mjs --alias:@=./src --packages=external && node --env-file=.env .tmp-reset-password.mjs",
    "dar-acceso": "esbuild scripts/dar-acceso-portal.ts --bundle --platform=node --format=esm --outfile=.tmp-dar-acceso.mjs --alias:@=./src --packages=external && node --env-file=.env .tmp-dar-acceso.mjs",
    "verify-grading": "esbuild scripts/verify-grading.ts --bundle --platform=node --format=esm --outfile=.tmp-verify-grading.mjs --alias:@=./src --packages=external && node --env-file=.env .tmp-verify-grading.mjs",
    "verify-billing": "esbuild scripts/verify-billing.ts --bundle --platform=node --format=esm --outfile=.tmp-verify-billing.mjs --alias:@=./src --packages=external && node --env-file=.env .tmp-verify-billing.mjs",
    "import:cadit": "esbuild scripts/import/cadit-2026.ts --bundle --platform=node --format=esm --outfile=.tmp-import-cadit.mjs --alias:@=./src --packages=external && node --env-file=.env .tmp-import-cadit.mjs",
    "verify-rls": "node scripts/verify-rls.mjs",
    "verificar-aulas": "esbuild scripts/verificar-aulas.ts --bundle --platform=node --format=esm --outfile=.tmp-verificar-aulas.mjs --alias:@=./src --packages=external && node --env-file=.env .tmp-verificar-aulas.mjs",
    "demo-camada": "esbuild scripts/demo-camada.ts --bundle --platform=node --format=esm --outfile=.tmp-demo-camada.mjs --alias:@=./src --packages=external && node --env-file=.env .tmp-demo-camada.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "better-auth": "^1.1.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.38.3",
    "lucide-react": "^0.469.0",
    "nanoid": "^5.0.9",
    "next": "^15.1.3",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.1",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "playwright": "^1.61.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
